---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
	title?: string;
	description?: string;
	activeNav?: "home" | "user" | "projects" | "blog" | "photos";
}

const { 
	title = "Rafli Hamdani — Personal Portfolio", 
	description = "Personal portfolio, thoughts, projects, and photography by Rafli Hamdani.",
	activeNav 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<script is:inline>
			// Inline script to prevent theme flash
			const theme = localStorage.getItem('theme');
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body
		class="bg-bg-page text-text-body min-h-screen font-sans antialiased selection:bg-brand-500/30 overflow-x-hidden flex flex-col items-center"
	>
		<Navbar active={activeNav} />
		<main
			class="w-full pt-24 pb-20 px-4 sm:px-6 md:pt-16 md:pb-24 md:pl-28 md:pr-10 max-w-5xl transition-all duration-300"
		>
			<slot />
		</main>
		<footer class="w-full text-center py-8 text-xs text-text-muted border-t border-border-subtle/40 md:pl-24">
			<p>© {new Date().getFullYear()} Rafli Hamdani. Built with Astro & Tailwind CSS.</p>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>

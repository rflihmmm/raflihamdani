---
import ExternalLinkIcon from "./icons/ExternalLinkIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";

interface Props {
  title: string;
  description: string;
  tags: string[];
  demoUrl?: string;
  githubUrl?: string;
  featured?: boolean;
  class?: string;
}

const { title, description, tags, demoUrl = "#", githubUrl = "#", featured = false, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "group relative flex flex-col justify-between overflow-hidden rounded-xl border border-border-subtle bg-bg-surface/60 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-500/50 hover:bg-bg-elevated/60 hover:shadow-lg hover:shadow-brand-500/5",
    featured ? "border-brand-500/30 bg-bg-surface md:col-span-2" : "",
    className
  ]}
>
  <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-brand-500/10 blur-3xl transition-all duration-500 group-hover:bg-brand-500/20"></div>

  <div>
    <h3 class="mb-2 text-xl font-bold text-text-heading transition-colors group-hover:text-brand-400">
      {title}
    </h3>
    <p class="text-sm leading-relaxed text-text-muted">
      {description}
    </p>
  </div>

  <div class="mt-5 flex flex-col gap-4 border-t border-border-subtle/50 pt-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full border border-brand-500/25 bg-brand-500/10 px-2.5 py-1 font-mono text-[10px] font-medium uppercase tracking-[0.08em] text-brand-600 dark:border-brand-500/15 dark:text-brand-300">
          {tag}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-1 sm:shrink-0">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Repository"
          class="rounded-md p-2 text-text-muted transition-colors hover:bg-bg-elevated hover:text-text-heading"
        >
          <GithubIcon width={20} height={20} class="h-5 w-5" />
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Live Demo"
          class="rounded-md p-2 text-text-muted transition-colors hover:bg-bg-elevated hover:text-brand-400"
        >
          <ExternalLinkIcon width={20} height={20} class="h-5 w-5" />
        </a>
      )}
    </div>
  </div>
</div>

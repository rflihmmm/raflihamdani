---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  readTime: string;
  category: string;
  slug: string;
}

const { title, excerpt, date, readTime, category, slug } = Astro.props;
---

<a
  href={`/blog#${slug}`}
  class="group block p-6 rounded-2xl border border-border-subtle bg-bg-surface/50 backdrop-blur-sm hover:bg-bg-surface hover:border-brand-500/40 hover:shadow-lg transition-all duration-300 relative overflow-hidden"
>
  <div class="flex items-center gap-3 text-xs text-text-muted mb-3 font-mono">
    <span class="px-2 py-0.5 rounded-full bg-brand-500/10 text-brand-400 font-sans font-medium border border-brand-500/20">
      {category}
    </span>
    <span>•</span>
    <time datetime={date}>{date}</time>
    <span>•</span>
    <span>{readTime}</span>
  </div>

  <h3 class="text-lg sm:text-xl font-bold text-text-heading group-hover:text-brand-400 transition-colors mb-2 line-clamp-2">
    {title}
  </h3>

  <p class="text-text-muted text-sm leading-relaxed line-clamp-2 mb-4">
    {excerpt}
  </p>

  <div class="inline-flex items-center text-xs font-semibold text-brand-400 group-hover:translate-x-1 transition-transform">
    <span>Baca artikel</span>
    <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>

---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import meImg from "../assets/me.jpg";

const experiences = [
  {
    role: "Full-Stack Developer",
    company: "Pallaka Techno",
    period: "Nov 2025 — Present",
    description:
      "Developing scalable web applications, engineering reliable software solutions, and crafting intuitive user interfaces.",
    achievements: [
      "Building and maintaining core web products and enterprise features.",
      "Collaborating on full-stack architecture, database design, and UI performance.",
    ],
  },
];
---

<Layout title="Profile — Rafli Hamdani" activeNav="user">
  <!-- PAGE HEADER -->
  <div class="mb-12">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold mb-4"
    >
      👤 Profile & Bio
    </div>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-heading mb-4"
    >
      About Me
    </h1>
    <p class="text-text-muted text-lg leading-relaxed max-w-2xl">
      A little about who I am and what I love to do.
    </p>
  </div>

  <!-- BIO & AVATAR SECTION (UNWRAPPED / NO CARD CONTAINER) -->
  <section class="mb-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-4 flex justify-center md:justify-start">
        <div class="relative group w-full max-w-xs">
          <div
            class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-brand-500 to-teal-400 opacity-40 blur-xl group-hover:opacity-75 transition duration-500"
          >
          </div>
          <div
            class="relative w-full aspect-[3/4] rounded-2xl overflow-hidden border-2 border-border-subtle shadow-xl bg-bg-surface"
          >
            <Image
              src={meImg}
              alt="Rafli Hamdani"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>
      </div>

      <div class="md:col-span-8 flex flex-col justify-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-heading mb-1">
          Rafli Hamdani
        </h2>
        <p class="text-brand-400 font-mono text-sm font-semibold mb-4">
          I build things, break things, and learn from both.
        </p>

        <div class="space-y-3 text-text-muted text-base leading-relaxed mb-6">
          <p>
            Nerd at heart, IT enthusiast by passion, and a lifelong learner by
            choice. A Politeknik Negeri Ujung Pandang graduate who enjoys
            exploring technology, building things, and learning something new
            along the way.
          </p>
          <p>
            I enjoy writing down the things I learn, the ideas that cross my
            mind, and the experiences worth sharing. Outside of the tech world,
            I find joy in photography—capturing moments, places, and little
            details that are worth remembering.
          </p>
          <p>
            When I'm away from the keyboard, you'll probably find me taking
            photos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK EXPERIENCE -->
  <section class="mb-16">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-text-heading mb-2">Work Experience</h2>
      <p class="text-text-muted text-sm">
        My professional journey and career milestones.
      </p>
    </div>

    <div class="relative border-l border-border-subtle ml-3 sm:ml-6 space-y-8">
      {
        experiences.map((exp) => (
          <div class="relative pl-6 sm:pl-8 group">
            <div class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-brand-500 border-2 border-bg-page group-hover:scale-125 transition-transform" />

            <div class="p-6 rounded-2xl border border-border-subtle bg-bg-surface/40 backdrop-blur-sm group-hover:border-brand-500/40 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                <h3 class="text-xl font-bold text-text-heading">{exp.role}</h3>
                <span class="px-2.5 py-0.5 rounded-full bg-brand-500/10 text-brand-400 text-xs font-mono font-semibold self-start sm:self-auto border border-brand-500/20">
                  {exp.period}
                </span>
              </div>

              <p class="text-brand-300 font-medium text-sm mb-3">
                {exp.company}
              </p>
              <p class="text-text-muted text-sm leading-relaxed mb-4">
                {exp.description}
              </p>

              <ul class="space-y-1.5 text-xs text-text-muted list-disc list-inside">
                {exp.achievements.map((ach) => (
                  <li>{ach}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

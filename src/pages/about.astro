---
import Layout from '../layouts/Layout.astro';
import profileImg from '../assets/stammy_profile.png';

const experiences = [
  {
    role: "Fullstack Software Engineer",
    company: "Development Lab / Self-Employed",
    period: "2024 — Sekarang",
    description: "Mengembangkan aplikasi web berbasis Astro, Laravel, Next.js, dan PostgreSQL. Merancang modul rekapitulasi data enterprise, optimasi query, dan UI/UX modern.",
    achievements: [
      "Mengembangkan modul Rekap ASN & Diklat Struktural dengan error boundary resilient.",
      "Meningkatkan kecepatan muat halaman web hingga 95+ Score pada Google Lighthouse.",
      "Mengimplementasikan sistem tema dinamis & responsive navigation."
    ]
  },
  {
    role: "Frontend Engineer",
    company: "Tech Agency / Projects",
    period: "2023 — 2024",
    description: "Membangun antarmuka pengguna interaktif menggunakan React, TypeScript, dan Tailwind CSS. Berfokus pada aksesibilitas dan performa frontend.",
    achievements: [
      "Membangun reusable UI component library yang digunakan di 5+ proyek web.",
      "Mengintegrasikan REST API & GraphQL dengan strategi caching yang efisien."
    ]
  },
  {
    role: "Junior Web Developer",
    company: "Software House",
    period: "2022 — 2023",
    description: "Pengembangan awal aplikasi berbasis PHP, MySQL, dan JavaScript. Melakukan pemeliharaan fitur, refactoring kode, dan perbaikan bug.",
    achievements: [
      "Perbaikan bug dan optimasi performa pada sistem internal.",
      "Dokumentasi API dan koordinasi dengan tim backend."
    ]
  }
];

const skillCategories = [
  {
    title: "Frontend Development",
    icon: "🌐",
    skills: ["Astro", "React", "Next.js", "TypeScript", "Tailwind CSS v4", "HTML5/CSS3", "JavaScript (ES6+)"]
  },
  {
    title: "Backend & Database",
    icon: "⚙️",
    skills: ["Laravel", "PHP 8+", "Node.js", "PostgreSQL", "MySQL", "REST API", "Database Optimization"]
  },
  {
    title: "Tools & Workflow",
    icon: "🛠️",
    skills: ["Git & GitHub", "Vite", "Docker Basics", "Linux Shell", "VS Code", "DataTables"]
  }
];
---

<Layout title="Profile — Rafli Hamdani" activeNav="user">
  <div class="mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold mb-4">
      👤 Profile & Experience
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-heading mb-4">
      Tentang Saya
    </h1>
    <p class="text-text-muted text-lg leading-relaxed max-w-2xl">
      Berdiri di antara dunia rekayasa perangkat lunak dan desain antarmuka, menciptakan produk digital yang fungsional, estetik, dan berdaya guna.
    </p>
  </div>

  <!-- BIO & AVATAR CARD -->
  <section class="mb-16">
    <div class="rounded-3xl border border-border-subtle bg-bg-surface/70 backdrop-blur-md p-6 sm:p-10 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-4 flex justify-center">
        <div class="relative group">
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-brand-500 to-teal-400 opacity-40 blur-xl group-hover:opacity-75 transition duration-500"></div>
          <div class="relative w-48 h-48 sm:w-56 sm:h-56 rounded-2xl overflow-hidden border-2 border-border-subtle shadow-xl bg-bg-surface">
            <img 
              src={profileImg.src} 
              alt="Rafli Hamdani Profile" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>
      </div>

      <div class="md:col-span-8 flex flex-col justify-center">
        <h2 class="text-2xl font-bold text-text-heading mb-2">Rafli Hamdani</h2>
        <p class="text-brand-400 font-mono text-sm font-semibold mb-4">Software Engineer & UI Developer</p>
        
        <div class="space-y-3 text-text-muted text-sm leading-relaxed mb-6">
          <p>
            Saya adalah seorang Software Engineer yang memiliki passion mendalam terhadap pengembangan web modern, arsitektur perangkat lunak, dan pengalaman pengguna (UX).
          </p>
          <p>
            Berpengalaman dalam membangun aplikasi web dari tahap konsep hingga deployment, menggunakan ekosistem JavaScript/TypeScript dan PHP/Laravel. Saya sangat menyukai tantangan teknis seperti optimasi performa query database, pembuatan komponen UI yang modular, serta integrasi API yang handal.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-border-subtle/50 text-xs">
          <div>
            <span class="text-text-muted block">Lokasi</span>
            <span class="font-semibold text-text-heading">Indonesia</span>
          </div>
          <div>
            <span class="text-text-muted block">Pengalaman</span>
            <span class="font-semibold text-text-heading">3+ Tahun</span>
          </div>
          <div>
            <span class="text-text-muted block">Status</span>
            <span class="font-semibold text-brand-400">Available</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS GRID -->
  <section class="mb-16">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-text-heading mb-2">Keahlian & Tech Stack</h2>
      <p class="text-text-muted text-sm">Teknologi dan tools yang biasa saya gunakan dalam alur kerja sehari-hari.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {skillCategories.map((cat) => (
        <div class="p-6 rounded-2xl border border-border-subtle bg-bg-surface/50 backdrop-blur-sm">
          <div class="text-3xl mb-3">{cat.icon}</div>
          <h3 class="text-lg font-bold text-text-heading mb-4">{cat.title}</h3>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class="px-2.5 py-1 rounded-lg bg-bg-elevated text-text-heading text-xs font-mono font-medium border border-border-subtle">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- WORK EXPERIENCE -->
  <section class="mb-16">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-text-heading mb-2">Pengalaman Kerja</h2>
      <p class="text-text-muted text-sm">Jejak karir dan peran penting dalam pengembangan aplikasi.</p>
    </div>

    <div class="relative border-l border-border-subtle ml-3 sm:ml-6 space-y-8">
      {experiences.map((exp) => (
        <div class="relative pl-6 sm:pl-8 group">
          <div class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-brand-500 border-2 border-bg-page group-hover:scale-125 transition-transform"></div>
          
          <div class="p-6 rounded-2xl border border-border-subtle bg-bg-surface/40 backdrop-blur-sm group-hover:border-brand-500/40 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="text-xl font-bold text-text-heading">{exp.role}</h3>
              <span class="px-2.5 py-0.5 rounded-full bg-brand-500/10 text-brand-400 text-xs font-mono font-semibold self-start sm:self-auto border border-brand-500/20">
                {exp.period}
              </span>
            </div>
            
            <p class="text-brand-300 font-medium text-sm mb-3">{exp.company}</p>
            <p class="text-text-muted text-sm leading-relaxed mb-4">{exp.description}</p>
            
            <ul class="space-y-1.5 text-xs text-text-muted list-disc list-inside">
              {exp.achievements.map((ach) => (
                <li>{ach}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

</Layout>

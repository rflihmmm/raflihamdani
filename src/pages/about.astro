---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import meImg from "../assets/me.jpg";

const experiences = [
  {
    role: "Full-Stack Developer",
    company: "Pallaka Techno",
    period: "Nov 2025 — Present",
    description:
      "Developing scalable web applications, engineering reliable software solutions, and crafting intuitive user interfaces.",
    achievements: [
      "Building and maintaining core web products and enterprise features.",
      "Collaborating on full-stack architecture, database design, and UI performance.",
    ],
  },
];
---

<Layout title="About | Rafli Hamdani" activeNav="user">
  <!-- PAGE HEADER -->
  <div class="reveal mb-16" style="--index: 0">
    <p class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-brand-400">
      Profile & Bio
    </p>
    <!-- <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-[-0.03em] text-text-heading mb-3">
      About Me
    </h1> -->
    <p class="text-text-muted text-base sm:text-lg leading-relaxed max-w-2xl">
      A little about who I am and what I love to do.
    </p>
  </div>

  <!-- BIO SECTION -->
  <section class="mb-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      <div class="reveal md:col-span-4 flex justify-center md:justify-start" style="--index: 1">
        <div class="w-full max-w-xs overflow-hidden rounded-2xl">
          <Image
            src={meImg}
            alt="Rafli Hamdani"
            class="aspect-[3/4] w-full object-cover grayscale-[15%] transition duration-500 hover:grayscale-0"
          />
        </div>
      </div>

      <div class="reveal md:col-span-8 flex flex-col justify-center" style="--index: 2">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.02em] text-text-heading mb-1">
          Rafli Hamdani
        </h2>
        <p class="text-brand-400 font-mono text-sm font-semibold mb-5">
          I build things, break things, and learn from both.
        </p>

        <div class="space-y-4 text-text-muted text-base leading-7">
          <p>
            Nerd at heart, IT enthusiast by passion, and a lifelong learner by
            choice. A Politeknik Negeri Ujung Pandang graduate who enjoys
            exploring technology, building things, and learning something new
            along the way.
          </p>
          <p>
            I enjoy writing down the things I learn, the ideas that cross my
            mind, and the experiences worth sharing. Outside of the tech world,
            I find joy in photography—capturing moments, places, and little
            details that are worth remembering.
          </p>
          <p>
            When I'm away from the keyboard, you'll probably find me taking
            photos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK EXPERIENCE -->
  <section class="mb-12">
    <div class="reveal mb-8 border-b border-border-subtle/70 pb-6" style="--index: 0">
      <h2 class="text-2xl font-bold tracking-[-0.025em] text-text-heading mb-2">Work Experience</h2>
      <p class="text-text-muted text-sm">
        My professional journey and career milestones.
      </p>
    </div>

    <div class="space-y-4">
      {
        experiences.map((exp, index) => (
          <article
            class="reveal rounded-xl border border-border-subtle/70 bg-bg-surface/35 p-6 transition duration-200 hover:border-brand-500/40 hover:bg-bg-elevated/70"
            style={`--index: ${index + 1}`}
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="text-xl font-bold tracking-[-0.02em] text-text-heading">{exp.role}</h3>
              <span class="font-mono text-xs tracking-[0.08em] text-brand-400">
                {exp.period}
              </span>
            </div>

            <p class="text-brand-300 font-medium text-sm mb-3">
              {exp.company}
            </p>
            <p class="text-text-muted text-sm leading-7 mb-4">
              {exp.description}
            </p>

            <ul class="space-y-1.5 text-xs text-text-muted list-disc list-inside">
              {exp.achievements.map((ach) => (
                <li>{ach}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    const revealItems = document.querySelectorAll(".reveal");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    revealItems.forEach((item) => observer.observe(item));
  </script>
</Layout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--index, 0) * 80ms);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

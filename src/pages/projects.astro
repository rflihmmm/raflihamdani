---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projectsList = [
  {
    title: "HRIS & Rekap ASN Enterprise",
    description: "Sistem manajemen data pegawai ASN berbasis Laravel & PostgreSQL dengan integrasi modul rekapitulasi eselon, diklat, dan pelantikan secara terdistribusi.",
    tags: ["Laravel", "PostgreSQL", "PHP 8", "DataTables", "Tailwind CSS"],
    icon: "⚡",
    featured: true,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "AI Topic Insights & WordCloud Dashboard",
    description: "Aplikasi analitik teks dan topik artikel menggunakan React & Next.js dengan error boundary resilient untuk mengisolasi kegagalan modul API.",
    tags: ["Next.js", "React", "TypeScript", "Tailwind CSS", "Recharts"],
    icon: "🧠",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Astro High-Performance Portfolio",
    description: "Website personal portofolio ultra-ringkas menggunakan Astro 5, Tailwind CSS v4, serta komponen UI kustom dengan dukungan dark mode otomatis.",
    tags: ["Astro 5", "Tailwind v4", "TypeScript", "HTML5/CSS3"],
    icon: "🚀",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Realtime Attendance & Location App",
    description: "Aplikasi presensi berbasis lokasi geofencing dengan dukungan foto selfie, rekap absensi otomatis, dan notifikasi push.",
    tags: ["React Native", "Node.js", "Express", "MongoDB"],
    icon: "📍",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Dynamic Content Management System",
    description: "Headless CMS ringan untuk manajemen artikel, galeri foto, serta publikasi pengumuman dengan performa query teroptimasi.",
    tags: ["Laravel API", "Vue.js", "MySQL", "Tailwind CSS"],
    icon: "📰",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Developer Tools CLI Kit",
    description: "Tool CLI internal untuk otomatisasi sinkronisasi database staging, validasi konfigurasi environment, serta pembuatan laporan log.",
    tags: ["Node.js", "Bash", "CLI", "JSON Schema"],
    icon: "🛠️",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  }
];
---

<Layout title="Projects — Rafli Hamdani" activeNav="projects">
  <div class="mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold mb-4">
      💻 Portofolio Karya
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-heading mb-4">
      Proyek & Eksperimen
    </h1>
    <p class="text-text-muted text-lg leading-relaxed max-w-2xl">
      Koleksi proyek pilihan yang pernah saya kembangkan—mulai dari sistem informasi enterprise hingga aplikasi web modern dan open source tools.
    </p>
  </div>

  <!-- PROJECTS GRID -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projectsList.map((project) => (
      <ProjectCard {...project} />
    ))}
  </div>
</Layout>

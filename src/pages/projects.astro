---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projectsList = [
  {
    title: "HRIS & ASN Enterprise Recap",
    description: "Civil servant data management system built with Laravel & PostgreSQL, with distributed recap modules for rank, training, and appointment records.",
    tags: ["Laravel", "PostgreSQL", "PHP 8", "DataTables", "Tailwind CSS"],
    icon: "⚡",
    featured: true,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "AI Topic Insights & WordCloud Dashboard",
    description: "Text and article topic analytics app built with React & Next.js, using resilient error boundaries to isolate API module failures.",
    tags: ["Next.js", "React", "TypeScript", "Tailwind CSS", "Recharts"],
    icon: "🧠",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Astro High-Performance Portfolio",
    description: "An ultra-lightweight personal portfolio site built with Astro 5, Tailwind CSS v4, and custom UI components with automatic dark mode support.",
    tags: ["Astro 5", "Tailwind v4", "TypeScript", "HTML5/CSS3"],
    icon: "🚀",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Realtime Attendance & Location App",
    description: "A geofencing-based attendance app with selfie photo verification, automatic attendance recaps, and push notifications.",
    tags: ["React Native", "Node.js", "Express", "MongoDB"],
    icon: "📍",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Dynamic Content Management System",
    description: "A lightweight headless CMS for managing articles, photo galleries, and announcement publishing with optimized query performance.",
    tags: ["Laravel API", "Vue.js", "MySQL", "Tailwind CSS"],
    icon: "📰",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Developer Tools CLI Kit",
    description: "An internal CLI tool for automating staging database sync, environment configuration validation, and log report generation.",
    tags: ["Node.js", "Bash", "CLI", "JSON Schema"],
    icon: "🛠️",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  }
];
---

<Layout title="Projects — Rafli Hamdani" activeNav="projects">
  <div class="mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold mb-4">
      💻 Portfolio of Work
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-heading mb-4">
      Projects & Experiments
    </h1>
    <p class="text-text-muted text-lg leading-relaxed max-w-2xl">
      A selection of projects I've built—ranging from enterprise information systems to modern web apps and open source tools.
    </p>
  </div>

  <!-- PROJECTS GRID -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projectsList.map((project) => (
      <ProjectCard {...project} />
    ))}
  </div>
</Layout>

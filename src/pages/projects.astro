---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { features } from '../config/features';
import { projectsList } from '../config/projects';

if (!features.projects) {
  return Astro.rewrite("/404");
}

---

<Layout title="Projects — Rafli Hamdani" activeNav="projects">
  <div class="reveal mb-10" style="--index: 0">
    <p class="mb-2 font-mono text-[12px] font-medium uppercase tracking-[0.24em] text-brand-400">
      Portfolio of Work
    </p>
    <p class="text-text-muted text-lg leading-relaxed max-w-2xl">
      A selection of projects I've built—ranging from enterprise information systems to modern web apps and open source tools.
    </p>
  </div>

  <!-- PROJECTS GRID -->
  <div class="reveal grid grid-cols-1 md:grid-cols-2 gap-6" style="--index: 1">
    {projectsList.map((project) => (
      <ProjectCard {...project} class="reveal" />
    ))}
  </div>
</Layout>

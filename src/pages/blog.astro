---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(date);

const toDateTime = (date: Date) => date.toISOString().slice(0, 10);

const blogPosts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPost = blogPosts[0];
const otherPosts = blogPosts.slice(1);
---

<Layout
  title="Blog — Rafli Hamdani"
  description="Technical notes, software engineering writing, and learning journal by Rafli Hamdani."
  activeNav="blog"
>
  <div class="mb-12">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold mb-4"
    >
      📖 Notes & Articles
    </div>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-heading mb-4"
    >
      Technical Writing & Journal
    </h1>
    <p class="text-text-muted text-lg leading-relaxed max-w-2xl">
      Sharing insights on software engineering, web architecture,
      application optimization experience, and development tips.
    </p>
  </div>

  {
    featuredPost ? (
      <section class="mb-12">
        <a
          href={`/blog/${featuredPost.id}/`}
          class="group block rounded-3xl border border-brand-500/30 bg-gradient-to-br from-bg-surface via-bg-elevated/40 to-bg-surface p-6 sm:p-8 relative overflow-hidden shadow-xl hover:border-brand-500/60 transition-all duration-300"
        >
          <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand-500/15 rounded-full blur-3xl group-hover:bg-brand-500/25 transition-all" />

          <div class="flex items-center gap-3 text-xs text-text-muted mb-4 font-mono">
            <span class="px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 font-sans font-bold border border-brand-500/30">
              Featured Article
            </span>
            <span>•</span>
            <time datetime={toDateTime(featuredPost.data.pubDate)}>
              {formatDate(featuredPost.data.pubDate)}
            </time>
            <span>•</span>
            <span>{featuredPost.data.readTime}</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold text-text-heading group-hover:text-brand-400 transition-colors mb-3">
            {featuredPost.data.title}
          </h2>

          <p class="text-text-muted text-sm sm:text-base leading-relaxed mb-6 max-w-3xl">
            {featuredPost.data.excerpt}
          </p>

          <div class="inline-flex items-center gap-2 text-sm font-semibold text-brand-400 group-hover:translate-x-1 transition-transform">
            <span>Read full article</span>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </div>
        </a>
      </section>
    ) : (
      <section class="mb-12 rounded-2xl border border-border-subtle bg-bg-surface/50 p-6">
        <p class="text-text-muted">
          No articles published yet.
        </p>
      </section>
    )
  }

  {
    otherPosts.length > 0 && (
      <section class="mb-16">
        <h2 class="text-xl font-bold text-text-heading mb-6">
          More Articles
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {otherPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.excerpt}
              date={toDateTime(post.data.pubDate)}
              readTime={post.data.readTime}
              category={post.data.category}
              slug={post.id}
            />
          ))}
        </div>
      </section>
    )
  }
</Layout>

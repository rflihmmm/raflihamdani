---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import profileImg from '../assets/stammy_profile.png';

const featuredProjects = [
  {
    title: "HRIS & Rekap ASN Enterprise",
    description: "Sistem manajemen & rekapitulasi data ASN real-time dengan integrasi database terdistribusi dan ekspor laporan dinamis.",
    tags: ["Laravel", "PostgreSQL", "PHP 8", "DataTables"],
    icon: "⚡",
    featured: true,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "AI Topic Insights Dashboard",
    description: "Dashboard analitik AI untuk ekstraksi topik, pemrosesan kata kunci, dan error-boundary resilient visualisasi data.",
    tags: ["Next.js", "React", "Tailwind CSS", "TypeScript"],
    icon: "🧠",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  },
  {
    title: "Astro Modern Portfolio",
    description: "Website portofolio ultra-cepat dibangun menggunakan Astro 5, Tailwind CSS 4, dan arsitektur komponen modular.",
    tags: ["Astro", "Tailwind v4", "TypeScript"],
    icon: "🚀",
    featured: false,
    githubUrl: "https://github.com",
    demoUrl: "https://example.com"
  }
];

const featuredPosts = [
  {
    title: "Membangun Web Super Cepat Menggunakan Astro & Tailwind CSS v4",
    excerpt: "Panduan praktis mengoptimalkan performa halaman web dengan zero-JavaScript by default dan konfigurasi Tailwind CSS v4 terbaru.",
    date: "24 Jul 2026",
    readTime: "5 min baca",
    category: "Web Development",
    slug: "astro-tailwind-v4"
  },
  {
    title: "Resilient Error Handling Pada React & Component Error Boundaries",
    excerpt: "Bagaimana cara menangani kegagalan API secara parsial tanpa membuat seluruh tampilan aplikasi crash.",
    date: "12 Jul 2026",
    readTime: "7 min baca",
    category: "Frontend Architecture",
    slug: "react-error-handling"
  },
  {
    title: "Optimasi Query Database PostgreSQL & Laravel Batching",
    excerpt: "Teknik optimasi pencarian data pegawai, pembagian query terdistribusi, dan pencegahan memory leak.",
    date: "28 Jun 2026",
    readTime: "6 min baca",
    category: "Backend & Database",
    slug: "laravel-postgresql-optimization"
  }
];

const photoHighlights = [
  {
    title: "Minimalist Architecture",
    category: "Urban",
    location: "Jakarta, Indonesia",
    aspect: "col-span-1 row-span-1",
    bg: "from-blue-900/60 to-indigo-900/60"
  },
  {
    title: "Golden Hour Glow",
    category: "Nature",
    location: "Bandung Highlands",
    aspect: "col-span-1 row-span-2",
    bg: "from-amber-900/60 to-orange-900/60"
  },
  {
    title: "City Lights & Motion",
    category: "Nightlife",
    location: "Central Business District",
    aspect: "col-span-1 row-span-1",
    bg: "from-purple-900/60 to-pink-900/60"
  },
  {
    title: "Serenity by the Coast",
    category: "Landscape",
    location: "Bali Coastlines",
    aspect: "col-span-1 row-span-1",
    bg: "from-teal-900/60 to-emerald-900/60"
  }
];
---

<Layout title="Rafli Hamdani — Home & Highlights" activeNav="home">
  <!-- Hero Section -->
  <section class="mb-20">
    <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-10">
      <div class="flex-1 text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
          Terbuka untuk kolaborasi & proyek
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-text-heading mb-4 leading-tight">
          Halo, Saya <span class="bg-gradient-to-r from-brand-400 via-teal-300 to-emerald-400 bg-clip-text text-transparent">Rafli Hamdani</span>
        </h1>

        <p class="text-text-muted text-lg sm:text-xl font-normal leading-relaxed mb-8 max-w-2xl">
          Software Engineer & Creative Tech Enthusiast. Berfokus pada pembuatan aplikasi web performa tinggi, sistem informasi enterprise, serta pengalaman pengguna yang modern dan intuitif.
        </p>

        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
          <a
            href="/about"
            class="px-6 py-3 rounded-xl bg-brand-500 text-white font-medium hover:bg-brand-600 transition-all shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5"
          >
            Jelajahi Profil
          </a>
          <a
            href="/projects"
            class="px-6 py-3 rounded-xl bg-bg-surface border border-border-subtle text-text-heading font-medium hover:bg-bg-elevated transition-all hover:border-brand-500/30"
          >
            Lihat Portofolio
          </a>
        </div>
      </div>

      <!-- Avatar Banner -->
      <div class="relative group">
        <div class="absolute -inset-1 rounded-[2.5rem] bg-gradient-to-r from-brand-500 to-teal-400 opacity-30 blur-xl group-hover:opacity-60 transition duration-500"></div>
        <div class="relative w-44 h-44 sm:w-56 sm:h-56 md:w-64 md:h-64 rounded-[2.2rem] overflow-hidden border-2 border-border-subtle shadow-2xl bg-bg-surface">
          <Image 
            src={profileImg} 
            alt="Rafli Hamdani Profile" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHT 1: PROFILE SUMMARY -->
  <section class="mb-20">
    <SectionHeader 
      badge="Highlight 1"
      title="Tentang & Profil Singkat" 
      subtitle="Sekilas latar belakang profesional, keahlian utama, dan bidang fokus."
      linkHref="/about"
      linkLabel="Lihat Profil Selengkapnya →"
    />

    <div class="rounded-2xl border border-border-subtle bg-bg-surface/60 backdrop-blur-md p-6 sm:p-8 relative overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="p-4 rounded-xl bg-bg-elevated/60 border border-border-subtle">
          <div class="text-3xl mb-2">💻</div>
          <h3 class="font-bold text-text-heading mb-1">Fullstack Development</h3>
          <p class="text-text-muted text-xs leading-relaxed">Pengalaman mengembangkan arsitektur frontend modern dan backend robust.</p>
        </div>
        <div class="p-4 rounded-xl bg-bg-elevated/60 border border-border-subtle">
          <div class="text-3xl mb-2">📊</div>
          <h3 class="font-bold text-text-heading mb-1">Enterprise Systems</h3>
          <p class="text-text-muted text-xs leading-relaxed">Spesialisasi manajemen data skala besar, rekapitulasi, & modul analitik.</p>
        </div>
        <div class="p-4 rounded-xl bg-bg-elevated/60 border border-border-subtle">
          <div class="text-3xl mb-2">🎨</div>
          <h3 class="font-bold text-text-heading mb-1">UI/UX & Performance</h3>
          <p class="text-text-muted text-xs leading-relaxed">Penerapan standar visual modern, glassmorphism, & kecepatan muat halaman.</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 pt-4 border-t border-border-subtle/50 text-xs">
        <span class="text-text-muted font-medium mr-2">Teknologi Utama:</span>
        {["TypeScript", "Laravel", "Astro", "React", "PostgreSQL", "Tailwind CSS", "Next.js"].map(skill => (
          <span class="px-2.5 py-1 rounded-lg bg-bg-elevated text-brand-400 font-mono font-medium border border-border-subtle">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- HIGHLIGHT 2: PROJECTS -->
  <section class="mb-20">
    <SectionHeader 
      badge="Highlight 2"
      title="Proyek & Karya Pilihan" 
      subtitle="Koleksi proyek aplikasi web, dashboard analitik, dan tools yang telah dikembangkan."
      linkHref="/projects"
      linkLabel="Semua Proyek →"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>

  <!-- HIGHLIGHT 3: BLOG -->
  <section class="mb-20">
    <SectionHeader 
      badge="Highlight 3"
      title="Artikel & Catatan Teknis" 
      subtitle="Berbagi pemikiran, solusi masalah teknis, dan tutorial pemrograman."
      linkHref="/blog"
      linkLabel="Baca Semua Artikel →"
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredPosts.map((post) => (
        <BlogCard {...post} />
      ))}
    </div>
  </section>

  <!-- HIGHLIGHT 4: PHOTOS -->
  <section class="mb-12">
    <SectionHeader 
      badge="Highlight 4"
      title="Galeri Foto & Kreativitas Visual" 
      subtitle="Momen visual, fotografi arsitektur, lanskap, dan kehidupan sehari-hari."
      linkHref="/photos"
      linkLabel="Buka Galeri Foto →"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {photoHighlights.map((photo) => (
        <a
          href="/photos"
          class="group relative h-64 rounded-2xl overflow-hidden border border-border-subtle bg-bg-surface flex flex-col justify-end p-5 transition-all duration-300 hover:border-brand-500/50 hover:shadow-xl hover:-translate-y-1"
        >
          <div class={`absolute inset-0 bg-gradient-to-t ${photo.bg} opacity-80 group-hover:scale-110 transition-transform duration-500`}></div>
          <div class="absolute inset-0 bg-gradient-to-t from-bg-page/90 via-bg-page/20 to-transparent"></div>
          
          <div class="relative z-10">
            <span class="text-[10px] font-mono uppercase tracking-widest text-brand-300 font-semibold mb-1 block">
              {photo.category}
            </span>
            <h3 class="text-base font-bold text-white group-hover:text-brand-300 transition-colors mb-1">
              {photo.title}
            </h3>
            <p class="text-xs text-neutral-300 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {photo.location}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

</Layout>

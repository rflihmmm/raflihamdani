---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import meImg from '../assets/me.jpg';
import { featuredProjects, featuredPosts, photoHighlights } from '../data/home';
import { features } from '../config/features';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout title="Rafli Hamdani — Home" activeNav="home">
  <!-- Hero Section -->
  <section class="reveal mb-20" style="--index: 0">
    <div class="grid items-center gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="flex justify-center lg:justify-start">
        <div class="w-full max-w-xs overflow-hidden rounded-2xl">
          <Image
            src={meImg}
            alt="Portrait of Rafli Hamdani"
            class="aspect-[3/4] w-full object-cover grayscale-[15%] transition duration-500 hover:grayscale-0"
          />
        </div>
      </div>

      <div>
        <p class="mb-5 font-mono text-[11px] font-medium uppercase tracking-[0.26em] text-brand-400">
          Welcome to my corner of the web
        </p>

        <h1 class="max-w-2xl text-4xl font-bold leading-[1.05] tracking-[-0.04em] text-text-heading sm:text-5xl">
          Hi, I'm Rafli Hamdani. I build things, break things, and learn from both.
        </h1>

        <p class="mt-5 max-w-xl text-base leading-8 text-text-muted sm:text-lg">
          Nerd at heart, IT enthusiast by passion, and a lifelong learner by choice. This is where I share what I'm working on, what I'm learning, and a few things in between.
        </p>

        {features.about && (
          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="/about"
              class="inline-flex items-center justify-center rounded-md bg-brand-500 px-5 py-3 text-sm font-medium text-white transition duration-200 hover:bg-brand-600 active:scale-[0.98]"
            >
              Read More
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- HIGHLIGHT 1: PROJECTS -->
  {features.homeHighlights.projects && (
  <section class="mb-20">
    <div class="reveal mb-6 flex flex-col justify-between gap-3 border-b border-border-subtle/70 pb-4 md:flex-row md:items-end" style="--index: 0">
      <div>
        <h2 class="max-w-2xl text-3xl font-bold tracking-[-0.035em] text-text-heading sm:text-3xl">
          Projects & Work
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-7 text-text-muted">
          From web apps and dashboards to IoT and internal tools — a look at what I've built.
        </p>
      </div>
      <a href="/projects" class="text-sm font-medium text-brand-400 transition hover:text-brand-300">
        All Projects →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
      {featuredProjects.map((project, index) => (
        <div
          class:list={["reveal", project.featured ? "md:col-span-2" : ""]}
          style={`--index: ${index}`}
        >
          <ProjectCard {...project} class="h-full" />
        </div>
      ))}
    </div>
  </section>
  )}

  <!-- HIGHLIGHT 2: BLOG -->
  {features.homeHighlights.blog && (
  <section class="mb-20">
    <div class="reveal mb-6 flex flex-col justify-between gap-3 border-b border-border-subtle/70 pb-4 md:flex-row md:items-end" style="--index: 0">
      <div>
        <h2 class="max-w-2xl text-3xl font-bold tracking-[-0.035em] text-text-heading sm:text-4xl">
          Articles & technical notes
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-7 text-text-muted">
          Sharing thoughts, technical problem-solving, and programming tutorials from day-to-day work.
        </p>
      </div>
      <a href="/blog" class="text-sm font-medium text-brand-400 transition hover:text-brand-300">
        Read All Articles →
      </a>
    </div>

    <div class="divide-y divide-border-subtle/70 rounded-xl border border-border-subtle/70 bg-bg-surface/30">
      {featuredPosts.map((post, index) => (
        <a
          href={`/blog/${post.slug}/`}
          class="reveal group grid gap-4 p-5 transition duration-200 hover:bg-bg-elevated/60 sm:grid-cols-[0.35fr_1fr] sm:p-6"
          style={`--index: ${index}`}
        >
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-400">{post.category}</p>
            <p class="mt-2 text-xs text-text-muted">{post.date} · {post.readTime}</p>
          </div>

          <div>
            <h3 class="text-xl font-bold leading-snug tracking-[-0.02em] text-text-heading transition group-hover:text-brand-300">
              {post.title}
            </h3>
            <p class="mt-2 max-w-2xl text-sm leading-7 text-text-muted">
              {post.excerpt}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
  )}

  <!-- HIGHLIGHT 3: PHOTOS -->
  {features.homeHighlights.photos && (
  <section class="mb-8">
    <div class="reveal mb-6 flex flex-col justify-between gap-3 border-b border-border-subtle/70 pb-4 md:flex-row md:items-end" style="--index: 0">
      <div>
        <h2 class="max-w-2xl text-3xl font-bold tracking-[-0.035em] text-text-heading sm:text-3xl">
          Photo gallery & visual creativity
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-7 text-text-muted">
          Visual moments, architecture photography, landscapes, and everyday life in a quiet format.
        </p>
      </div>
      <a href="/photos" class="text-sm font-medium text-brand-400 transition hover:text-brand-300">
        Open Photo Gallery →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {photoHighlights.map((photo, index) => (
        <a
          href="/photos"
          class="reveal group flex min-h-64 flex-col justify-between rounded-xl border border-border-subtle/70 bg-bg-surface/35 p-5 transition duration-200 hover:border-brand-500/40 hover:bg-bg-elevated/70 hover:shadow-[0_2px_8px_rgba(0,0,0,0.04)]"
          style={`--index: ${index}`}
        >
          <div class:list={["h-24 rounded-lg border p-3", photo.tone]}>
            <div class="h-full border-l border-current/30 pl-3">
              <div class="h-px w-12 bg-current/40"></div>
              <div class="mt-4 h-px w-20 bg-current/25"></div>
              <div class="mt-4 h-px w-8 bg-current/35"></div>
            </div>
          </div>

          <div class="mt-6">
            <span class="mb-2 block font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-300">
              {photo.category}
            </span>
            <h3 class="text-base font-bold text-text-heading transition group-hover:text-brand-300">
              {photo.title}
            </h3>
            <p class="mt-2 text-xs leading-5 text-text-muted">
              {photo.location}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
  )}

  <script>
    const revealItems = document.querySelectorAll(".reveal");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    revealItems.forEach((item) => observer.observe(item));
  </script>

</Layout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--index, 0) * 80ms);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
